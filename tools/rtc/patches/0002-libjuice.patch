+JUICE_EXPORT int juice_get_udp_poll_diagnostics(juice_agent_t *agent,
+    juice_diagnostics_t *summary, juice_udp_poll_diagnostics_t *out) {
+	if (!agent || !summary || !out)
+		return JUICE_ERR_INVALID;
+	conn_lock(agent);
+	*summary = agent->diagnostics;
+	summary->state = agent->state;
+	*out = agent->udp_poll_diagnostics;
+	// Normalize only on this cold query; writes remain O(1).
+	const unsigned int count = out->event_count;
+	const unsigned int first = (unsigned int)((out->events_total - count) % 16);
+	for (unsigned int i = 0; i < count; ++i)
+		out->events[i] = agent->udp_poll_diagnostics.events[(first + i) % 16];
+	// Filled by the clock helper shared with conn_poll.c.
+	out->sample_clock_available = juice_udp_poll_clock_preserving_errno(&out->sample_mono_us);
+	conn_unlock(agent);
+	return JUICE_ERR_SUCCESS;
+}
+
+JUICE_EXPORT int juice_get_diagnostics(juice_agent_t *agent, juice_diagnostics_t *out) {
+	if (!agent || !out)
+		return JUICE_ERR_INVALID;
+	conn_lock(agent);
+	*out = agent->diagnostics;
+	out->state = agent->state;
+	conn_unlock(agent);
+	return JUICE_ERR_SUCCESS;
+}
 

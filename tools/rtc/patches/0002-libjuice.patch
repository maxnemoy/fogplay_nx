+// Only connection initialization and poll processing write these fields.
+// Initialization precedes publication; poll processing holds registry->mutex.
+static void conn_poll_sample_rcvbuf(juice_agent_t *agent, socket_t sock) {
+	juice_udp_poll_diagnostics_t *d = &agent->udp_poll_diagnostics;
+	if (d->rcvbuf_checked)
+		return;
+	d->rcvbuf_checked = true;
+	sockopt_t size = 0;
+	socklen_t len = sizeof(size);
+	const int saved_errno = sockerrno;
+	d->rcvbuf_available = getsockopt(sock, SOL_SOCKET, SO_RCVBUF, (char *)&size, &len) == 0;
+	d->rcvbuf_errno = d->rcvbuf_available ? 0 : sockerrno;
+	d->rcvbuf_bytes = d->rcvbuf_available ? (int)size : 0;
+#ifdef _WIN32
+	WSASetLastError(saved_errno);
+#else
+	errno = saved_errno;
+#endif
+}
+
+typedef struct udp_poll_phase {
+	bool sampled, valid;
+	uint64_t last, recv_us, callback_us, receive_calls;
+} udp_poll_phase_t;
+
+// Only selected complete batches use packet clocks: 3 per positive receive,
+// 2 for a terminal receive. At most3000 extra reads for the1000-receive budget.
+static uint64_t conn_poll_phase_clock(udp_poll_phase_t *phase) {
+	uint64_t now = 0;
+	if (!juice_udp_poll_clock_preserving_errno(&now) || now < phase->last)
+		phase->valid = false;
+	phase->last = now;
+	return now;
+}
+
+static void conn_poll_record_udp(juice_agent_t *agent, uint64_t start, bool start_valid,
+    uint64_t gap, bool gap_valid, uint64_t ready_delay, bool ready_valid,
+    unsigned int received, uint64_t bytes,
+    unsigned int exit_reason, udp_poll_phase_t *phase) {
+	juice_udp_poll_diagnostics_t *d = &agent->udp_poll_diagnostics;
+	uint64_t end = 0;
+	const bool valid = juice_udp_poll_clock_preserving_errno(&end) && start_valid && end >= start;
+	const uint64_t elapsed = valid ? end - start : 0;
+	++d->batches;
+	d->bytes += bytes;
+	d->clock_available = valid;
+	d->last_clock_available = valid;
+	d->last_start_mono_us = start_valid ? start : 0;
+	d->last_end_mono_us = valid ? end : 0;
+	if (valid) {
+		++d->timed_batches;
+		d->elapsed_total_us += elapsed;
+		if (elapsed > d->elapsed_max_us) d->elapsed_max_us = elapsed;
+	} else {
+		++d->clock_invalid;
+	}
+	if (gap_valid) {
+		++d->service_gaps;
+		if (gap > d->service_gap_max_us) d->service_gap_max_us = gap;
+	}
+	if (ready_valid) {
+		++d->ready_delays;
+		if (ready_delay > d->ready_delay_max_us) d->ready_delay_max_us = ready_delay;
+	}
+	d->phase_sample_every = 16;
+	if (phase->sampled) {
+		++d->phase_sampled_batches;
+		d->phase_sampled_datagrams += received;
+		d->phase_sampled_receive_calls += phase->receive_calls;
+		// A phase failure does not invalidate overall timing. Valid phases require
+		// valid whole-batch boundaries and monotonic intermediate clocks.
+		phase->valid = phase->valid && valid && phase->last <= end &&
+		    phase->recv_us <= elapsed && phase->callback_us <= elapsed - phase->recv_us;
+		if (phase->valid) {
+			++d->phase_timed_batches;
+			d->phase_timed_datagrams += received;
+			d->phase_timed_receive_calls += phase->receive_calls;
+			d->phase_recv_total_us += phase->recv_us;
+			d->phase_callback_total_us += phase->callback_us;
+			if (phase->recv_us > d->phase_recv_batch_max_us)
+				d->phase_recv_batch_max_us = phase->recv_us;
+			if (phase->callback_us > d->phase_callback_batch_max_us)
+				d->phase_callback_batch_max_us = phase->callback_us;
+		} else ++d->phase_invalid_batches;
+	}
+	d->pending_yield = exit_reason == 1 && valid;
+	unsigned int flags = (received >= 256 ? 1u : 0u) | (valid && elapsed >= 5000 ? 2u : 0u) |
+	    (exit_reason == 1 ? 4u : 0u);
+	if (flags) ++d->legacy_eligible_batches;
+	if (received >= 256 || (valid && elapsed >= 50000) ||
+	    exit_reason == 1 || exit_reason == 3 || exit_reason == 4) {
+		if (phase->sampled) flags |= 64;
+		if (phase->sampled && phase->valid) flags |= 128;
+		if (valid) flags |= 8;
+		if (gap_valid) flags |= 16;
+		if (ready_valid) flags |= 32;
+		juice_udp_poll_event_t *event = &d->events[d->events_total % 16];
+		*event = (juice_udp_poll_event_t){++d->events_total, start_valid ? start : 0,
+		    elapsed, bytes, gap_valid ? gap : 0, ready_valid ? ready_delay : 0,
+		    received, flags, exit_reason,
+		    phase->sampled && phase->valid ? phase->recv_us : 0,
+		    phase->sampled && phase->valid ? phase->callback_us : 0};
+		if (d->event_count < 16) ++d->event_count;
+		else ++d->events_overwritten;
+	}
+}

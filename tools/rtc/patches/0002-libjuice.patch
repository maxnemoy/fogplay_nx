diff --git a/src/udp_poll_clock.h b/src/udp_poll_clock.h
new file mode 100644
--- /dev/null
+++ b/src/udp_poll_clock.h
@@ -0,0 +1,45 @@
+#ifndef JUICE_UDP_POLL_CLOCK_H
+#define JUICE_UDP_POLL_CLOCK_H
+#include <stdbool.h>
+#include <stdint.h>
+#include <errno.h>
+#ifdef _WIN32
+#include <winsock2.h>
+#endif
+#if (defined(__linux__) || defined(__SWITCH__)) && !defined(JUICE_UDP_POLL_TEST_CLOCK)
+#include <time.h>
+#endif
+#ifdef JUICE_UDP_POLL_TEST_CLOCK
+bool juice_udp_poll_clock(uint64_t *out);
+#else
+static inline bool juice_udp_poll_clock(uint64_t *out) {
+	*out = 0;
+#if defined(__linux__) || defined(__SWITCH__)
+	struct timespec ts;
+	if (clock_gettime(CLOCK_MONOTONIC, &ts) || ts.tv_sec < 0 ||
+	    ts.tv_nsec < 0 || ts.tv_nsec >= 1000000000)
+		return false;
+	*out = (uint64_t)ts.tv_sec * 1000000 + (uint64_t)ts.tv_nsec / 1000;
+	return true;
+#else
+	return false; // no wall-clock fallback or unsupported CPU-time claim
+#endif
+}
+#endif
+// Diagnostics must not modify the caller's receive/socket error, including
+// failed test clocks or platforms where clock_gettime can set errno.
+static inline bool juice_udp_poll_clock_preserving_errno(uint64_t *out) {
+#ifdef _WIN32
+	const int saved = WSAGetLastError();
+#else
+	const int saved = errno;
+#endif
+	const bool valid = juice_udp_poll_clock(out);
+#ifdef _WIN32
+	WSASetLastError(saved);
+#else
+	errno = saved;
+#endif
+	return valid;
+}
+#endif

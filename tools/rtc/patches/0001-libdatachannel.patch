+	snapshot.consentExpired = d.consent_expired;
+	snapshot.stunTimeouts = d.stun_timeouts;
+	snapshot.stunSendFailures = d.stun_send_failures;
+	snapshot.stunErrorResponses = d.stun_error_responses;
+	snapshot.stunErrorCode = d.stun_error_code;
+	snapshot.stunSendErrno = d.stun_send_errno;
+	snapshot.connectivityTimeouts = d.connectivity_timeouts;
+	switch (d.failure_reason) {
+	case JUICE_FAILURE_NONE: snapshot.failureReason = IceDiagnostics::FailureReason::None; break;
+	case JUICE_FAILURE_UDP_RECV: snapshot.failureReason = IceDiagnostics::FailureReason::UdpRecv; break;
+	case JUICE_FAILURE_UDP_POLL: snapshot.failureReason = IceDiagnostics::FailureReason::UdpPoll; break;
+	case JUICE_FAILURE_CONNECTION: snapshot.failureReason = IceDiagnostics::FailureReason::Connection; break;
+	case JUICE_FAILURE_CONSENT_EXPIRED: snapshot.failureReason = IceDiagnostics::FailureReason::ConsentExpired; break;
+	case JUICE_FAILURE_STUN_TIMEOUT: snapshot.failureReason = IceDiagnostics::FailureReason::StunTimeout; break;
+	case JUICE_FAILURE_STUN_SEND: snapshot.failureReason = IceDiagnostics::FailureReason::StunSend; break;
+	case JUICE_FAILURE_STUN_RESPONSE: snapshot.failureReason = IceDiagnostics::FailureReason::StunResponse; break;

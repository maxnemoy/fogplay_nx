+		queryLock.lock();
+	if (state.load() != State::Closed) {
+		if (auto ice = getIceTransport()) {
+			auto snapshot = ice->getIceDiagnostics();
+			std::lock_guard cacheLock(mTypedIceCacheMutex);
+			if (snapshot.availability == IceDiagnostics::Availability::Available) {
+				mFinalTypedIceDiagnostics = snapshot;
+				if (state.load() == State::Closed)
+					snapshot.provenance = IceDiagnostics::Provenance::FinalRetained;
+			}
+			return snapshot;
+		}
+	}
+	std::lock_guard cacheLock(mTypedIceCacheMutex);
+	auto snapshot = mFinalTypedIceDiagnostics;
+	if (snapshot.availability == IceDiagnostics::Availability::Available) {
+		snapshot.provenance = IceDiagnostics::Provenance::FinalRetained;
+	} else {
+#if !USE_NICE
+		snapshot.backend = IceDiagnostics::Backend::LibJuice;
+		snapshot.availability = state.load() == State::Closed
+		    ? IceDiagnostics::Availability::ClosedWithoutSample
+		    : IceDiagnostics::Availability::NotStarted;
+#else
+		snapshot.backend = IceDiagnostics::Backend::LibNice;
+		snapshot.availability = IceDiagnostics::Availability::NotSupported;
+#endif
+	}
+	return snapshot;

diff --git a/include/rtc/dtlsdiagnostics.hpp b/include/rtc/dtlsdiagnostics.hpp
new file mode 100644
--- /dev/null
+++ b/include/rtc/dtlsdiagnostics.hpp
@@ -0,0 +1,77 @@
+#ifndef RTC_DTLS_DIAGNOSTICS_H
+#define RTC_DTLS_DIAGNOSTICS_H
+
+#include <cstdint>
+
+namespace rtc {
+
+// Fork extension. Numeric aggregates for the lifetime of the DTLS transport;
+// not reset by clearStats(). No packet contents, endpoints or credentials.
+// All durations are integer microseconds on a steady clock, rounded per sample.
+// Queue and receiver groups are each coherent, but sampled independently.
+struct DtlsDiagnostics {
+    bool available = false; // false before DTLS exists
+    uint64_t queueDepth = 0, queueHighWater = 0, queueOldestAgeUs = 0;
+    uint64_t enqueued = 0, dequeued = 0;
+    // Enqueue acceptance to pop, excluding a producer's full-queue wait.
+    // Average = residenceTotalUs / dequeued (zero if dequeued == 0).
+    uint64_t residenceTotalUs = 0, residenceMaxUs = 0;
+    // Completed push calls that waited on a full queue (including stop wakeups).
+    // In-progress waits are not included. Average = total / count.
+    uint64_t fullPushWaitCount = 0, fullPushWaitTotalUs = 0, fullPushWaitMaxUs = 0;
+    uint64_t recvRuns = 0, recvScheduleCount = 0;
+    // Immediate enqueueRecv tasks only: submission to receiver lock acquisition.
+    // Includes thread-pool and receiver-lock contention. For mbedTLS, timer
+    // wakeups also submit coalesced receive tasks and are included.
+    uint64_t recvScheduleWaitTotalUs = 0, recvScheduleWaitMaxUs = 0;
+    // Completed doRecv calls: after receiver lock acquisition to return, including
+    // synchronous demux/application callbacks. Average = total / recvRuns.
+    uint64_t recvProcessingTotalUs = 0, recvProcessingMaxUs = 0;
+    // mbedTLS only: completed lock acquisitions around application writes and
+    // receiver TLS calls/staging (handshake key derivation included). Callback
+    // delivery and SRTP decryption are excluded. Average = total / lock count.
+    uint64_t sendSslLockCount = 0, sendSslLockWaitTotalUs = 0, sendSslLockWaitMaxUs = 0;
+    uint64_t sendSslLockHoldTotalUs = 0, sendSslLockHoldMaxUs = 0;
+    uint64_t recvSslLockCount = 0, recvSslLockWaitTotalUs = 0, recvSslLockWaitMaxUs = 0;
+    uint64_t recvSslLockHoldTotalUs = 0, recvSslLockHoldMaxUs = 0;
+    // Completed receive batches: datagrams popped, maximum per batch, and
+    // explicit fairness continuations (64 work units or 2 ms; one callback
+    // itself can overrun the time budget). TLS buffered records also continue.
+    uint64_t recvBatchPacketsTotal = 0, recvBatchPacketsMax = 0, recvBatchYields = 0;
+    // DTLS ingress only: capacity 1024, at most 960 RTP datagrams; FIFO among
+    // survivors. Critical = DTLS/SRTCP. New RTP is shed; critical admission at
+    // capacity evicts oldest RTP. All-critical overflow asynchronously fails.
+    uint64_t admissionMediaAccepted = 0, admissionControlAccepted = 0;
+    uint64_t admissionMediaDropped = 0, admissionMediaEvicted = 0;
+    uint64_t admissionInvalid = 0, admissionStopped = 0, admissionCriticalOverflow = 0;
+    // Completed per-packet stages; total/max in microseconds, including waits
+    // and preemption. Demux includes unprotect and media callback; nested
+    // stages must not be added together. Unprotect includes failed attempts.
+    uint64_t recvDemuxCount = 0, recvDemuxTotalUs = 0, recvDemuxMaxUs = 0;
+    uint64_t recvUnprotectCount = 0, recvUnprotectTotalUs = 0, recvUnprotectMaxUs = 0;
+    uint64_t recvMediaCallbackCount = 0, recvMediaCallbackTotalUs = 0, recvMediaCallbackMaxUs = 0;
+    uint64_t recvDataCallbackCount = 0, recvDataCallbackTotalUs = 0, recvDataCallbackMaxUs = 0;
+    uint64_t recvBatchTimeYields = 0, recvBatchWorkYields = 0, recvBatchEmpty = 0;
+
+    // Completed callbacks split by successfully decrypted datagram type.
+    // Their sum equals recvMediaCallback*; totals include waits/preemption.
+    uint64_t recvRtpCallbackCount = 0, recvRtpCallbackTotalUs = 0, recvRtpCallbackMaxUs = 0;
+    uint64_t recvRtcpCallbackCount = 0, recvRtcpCallbackTotalUs = 0, recvRtcpCallbackMaxUs = 0;
+    // sendMedia's distinct SRTP serialization lock, not mSslMutex. All calls,
+    // including pre-key/null rejections; hold includes protect and lower send.
+    uint64_t sendSrtpLockCount = 0, sendSrtpLockWaitTotalUs = 0, sendSrtpLockWaitMaxUs = 0;
+    uint64_t sendSrtpLockHoldTotalUs = 0, sendSrtpLockHoldMaxUs = 0;
+    uint64_t sendSrtpRejected = 0, sendSrtpFailed = 0;
+    // Valid post-key send attempts, including crypto/transport failures.
+    uint64_t sendRtpCount = 0, sendRtcpCount = 0;
+    uint64_t sendRtpProtectCount = 0, sendRtpProtectTotalUs = 0, sendRtpProtectMaxUs = 0;
+    uint64_t sendRtcpProtectCount = 0, sendRtcpProtectTotalUs = 0, sendRtcpProtectMaxUs = 0;
+    // Lower send includes ICE serialization, DSCP/socket work and UDP. Does
+    // not split them or include SRTP protect/serialization-lock wait.
+    uint64_t sendRtpLowerCount = 0, sendRtpLowerTotalUs = 0, sendRtpLowerMaxUs = 0;
+    uint64_t sendRtcpLowerCount = 0, sendRtcpLowerTotalUs = 0, sendRtcpLowerMaxUs = 0;
+
+};
+
+} // namespace rtc
+#endif

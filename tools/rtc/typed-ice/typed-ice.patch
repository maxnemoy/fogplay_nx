+// Only connection initialization and poll processing write these fields.
+// Initialization precedes publication; poll processing holds registry->mutex.
+static void conn_poll_sample_rcvbuf(juice_agent_t *agent, socket_t sock) {
+	juice_udp_poll_diagnostics_t *d = &agent->udp_poll_diagnostics;
+	if (d->rcvbuf_checked)
+		return;
+	d->rcvbuf_checked = true;
+	sockopt_t size = 0;
+	socklen_t len = sizeof(size);
+	const int saved_errno = sockerrno;
+	d->rcvbuf_available = getsockopt(sock, SOL_SOCKET, SO_RCVBUF, (char *)&size, &len) == 0;
+	d->rcvbuf_errno = d->rcvbuf_available ? 0 : sockerrno;
+	d->rcvbuf_bytes = d->rcvbuf_available ? (int)size : 0;
+#ifdef _WIN32
+	WSASetLastError(saved_errno);
+#else
+	errno = saved_errno;
+#endif
+}

+		out->events[i] = agent->udp_poll_diagnostics.events[(first + i) % 16];
+	// Filled by the clock helper shared with conn_poll.c.
+	out->sample_clock_available = juice_udp_poll_clock_preserving_errno(&out->sample_mono_us);
+	conn_unlock(agent);
+	return JUICE_ERR_SUCCESS;
+}
 

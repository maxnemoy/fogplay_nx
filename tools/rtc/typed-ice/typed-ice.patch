+IceUdpPollDiagnostics PeerConnection::getIceUdpPollDiagnostics() const {
+	std::unique_lock queryLock(mTypedIceQueryMutex, std::defer_lock);
+	if (state.load() != State::Closed) queryLock.lock();
+	if (state.load() != State::Closed) {
+		if (auto ice = getIceTransport()) {
+			auto snapshot = ice->getIceUdpPollDiagnostics();
+			std::lock_guard cacheLock(mTypedIceCacheMutex);
+			if (snapshot.ice.availability == IceDiagnostics::Availability::Available) {
+				mFinalUdpPollDiagnostics = snapshot;
+				mFinalTypedIceDiagnostics = snapshot.ice;
+				if (state.load() == State::Closed)
+					snapshot.ice.provenance = IceDiagnostics::Provenance::FinalRetained;
+			}
+			return snapshot;
+		}
+	}
+	std::lock_guard cacheLock(mTypedIceCacheMutex);
+	auto snapshot = mFinalUdpPollDiagnostics;
+	if (snapshot.ice.availability == IceDiagnostics::Availability::Available) {
+		snapshot.ice.provenance = IceDiagnostics::Provenance::FinalRetained;
+	} else {
+#if !USE_NICE
+		snapshot.ice.backend = IceDiagnostics::Backend::LibJuice;
+		snapshot.ice.availability = state.load() == State::Closed
+		    ? IceDiagnostics::Availability::ClosedWithoutSample
+		    : IceDiagnostics::Availability::NotStarted;
+#else
+		snapshot.ice.backend = IceDiagnostics::Backend::LibNice;
+		snapshot.ice.availability = IceDiagnostics::Availability::NotSupported;
+#endif
+	}
+	return snapshot;
+}
